{
    "name": "bradtipper/silverstripe-openapi-export",
    "description": "Describe Silverstripe controllers in code and export an OpenAPI 3.1 document with a build task",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "keywords": ["silverstripe", "openapi", "api"],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6"
    },
    "autoload": {
        "psr-4": {
            "BradTipper\\AppBackend\\OpenApi\\": "src/OpenApi/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
